# Core Server Configuration
APP_ENV=production
API_PORT=8000
DEBUG=false

# Redis & RQ Worker Infrastructure
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=document_ingestion

# Custom Retrieval-Augmented Generation (RAG) Memory
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_INDEX_PATH=./data/vector_store.index
VECTOR_DIMENSION=384

# AWS Infrastructure / Distributed Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=enterprise-document-ingestion-corpus
USE_MOCK_S3=true
LOCAL_STORAGE_DIR=./data/raw_documents
